#!/usr/bin/env python3
"""Run proqu straight from the plugin's files, with no install step."""

import os
import sys

if sys.version_info < (3, 10):  # noqa: UP036
    sys.exit(f"proqu needs Python 3.10 or newer, but python3 is {sys.version.split()[0]}")

root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(root, "src"))

from proqu.cli import main  # noqa: E402

sys.exit(main())
